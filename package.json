    "zenn-cli": "^0.5.2"
  },
  "devDependencies": {
    "textlint-config-rewse": ">=1.4.0"
  },
  "overrides": {
    "@hono/node-server": ">=2.0.5",
    "fast-uri": ">=4.1.1",
    "hono": ">=4.12.27",
